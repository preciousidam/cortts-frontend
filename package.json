{
  "name": "cortts-frontend",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "prepare": "husky install",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "storybook-generate": "sb-rn-get-stories",
    "upgrade-expo": "expo install expo@latest && npx expo install --fix",
    "tree": "tree -L 10 -I 'node_modules|.expo|.expo-shared|.git|.husky|.vscode|.DS_Store' -a > tree.txt",
    "export:web": "expo export --platform web",
    "eas:deploy": "expo export --platform web && eas deploy",
    "build:android:dev": "EXPO_TOKEN=$CORTTS_ACCESS_TOKEN_EAS eas build --platform android -e development",
    "build:android:preview": "EXPO_TOKEN=$CORTTS_ACCESS_TOKEN_EAS eas build --platform android -e preview",
    "build:android:prod": "EXPO_TOKEN=$CORTTS_ACCESS_TOKEN_EAS eas build --platform android -e production",
    "build:ios:dev": "EXPO_TOKEN=$CORTTS_ACCESS_TOKEN_EAS eas build --platform ios -e development",
    "build:ios:preview": "EXPO_TOKEN=$CORTTS_ACCESS_TOKEN_EAS eas build --platform ios -e preview",
    "build:ios:prod": "EXPO_TOKEN=$CORTTS_ACCESS_TOKEN_EAS eas build --platform ios -e production"
  },
  "jest": {
    "preset": "jest-expo"
  },
